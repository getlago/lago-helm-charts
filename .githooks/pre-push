#!/usr/bin/env bash
# Pre-push hook: validate that pushed tags match all Chart.yaml versions.
# Install with: task hooks:install

while read -r local_ref local_oid remote_ref remote_oid; do
  # Only check version tags
  case "$remote_ref" in
    refs/tags/v*)
      TAG="${remote_ref#refs/tags/v}"
      MISMATCH=0
      for chart in charts/*/Chart.yaml; do
        CHART_NAME=$(basename "$(dirname "$chart")")
        VERSION=$(grep '^version:' "$chart" | awk '{print $2}')
        if [ "$VERSION" != "$TAG" ]; then
          echo "❌ $CHART_NAME version ($VERSION) does not match tag (v$TAG)"
          MISMATCH=1
        fi
      done
      if [ "$MISMATCH" -eq 1 ]; then
        echo ""
        echo "Push rejected: chart versions do not match tag v$TAG"
        echo "Update all charts/*/Chart.yaml to version $TAG before tagging."
        exit 1
      fi
      echo "✅ All chart versions match tag v$TAG"
      ;;
  esac
done
